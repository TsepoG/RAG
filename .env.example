# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
# Values already exported in your shell take precedence over this file.

# Runtime mode: development | test | production (default: development)
NODE_ENV=development

# Log verbosity: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Port for the local web UI, 1-65535 (default: 3000)
PORT=3000

# Address the web UI listens on (default: 127.0.0.1). Only this machine (127.0.0.1, localhost or ::1)
# is accepted unless ALLOW_REMOTE=true, which the README advises against: the server has no login.
# HOST=127.0.0.1
# ALLOW_REMOTE=false

# How the assistant reads GitHub: "token" (default) for the fine-grained token in GITHUB_TOKEN, or
# "gh-cli" for your own GitHub CLI login (run `gh auth login` first, and `npm run github:check`
# before switching). In gh-cli mode GITHUB_TOKEN is not needed; if it is set, it is ignored.
# GITHUB_AUTH_MODE=token

# Optional, gh-cli mode only: the absolute path to the gh program (default: gh, found through PATH).
# GITHUB_CLI_PATH=C:\Program Files\GitHub CLI\gh.exe

# GitHub fine-grained personal access token (token mode). Create one at
# https://github.com/settings/personal-access-tokens/new with read-only access to Contents and
# Metadata, limited to the repositories listed in GITHUB_REPOS. Not used in gh-cli mode.
GITHUB_TOKEN=replace-with-your-github-token

# Repositories the assistant may read, comma-separated owner/repo pairs
GITHUB_REPOS=your-org/your-repo,your-org/another-repo

# Your Atlassian Cloud site, in the form https://<site>.atlassian.net
ATLASSIAN_SITE_URL=https://your-site.atlassian.net

# The cloudId of that site (getAccessibleAtlassianResources returns it). Optional in basic and
# bearer modes: when set, the assistant uses it on every Confluence call instead of looking it up,
# which saves tool calls. Required in oauth mode.
# ATLASSIAN_CLOUD_ID=00000000-0000-0000-0000-000000000000

# How the assistant signs in to Atlassian: "basic" for a personal API token (needs ATLASSIAN_EMAIL),
# "bearer" for a service-account API key (no email needed), or "oauth" for each person to sign in
# with their own Atlassian account from the web app (needs ATLASSIAN_CLOUD_ID and HOST=127.0.0.1;
# no email or API token).
ATLASSIAN_AUTH_MODE=basic

# Email address of the Atlassian account that owns the API token. Required in basic mode only.
ATLASSIAN_EMAIL=you@your-company.example

# Atlassian API token (basic mode: https://id.atlassian.com/manage-profile/security/api-tokens) or
# service-account API key (bearer mode). Needs the Rovo MCP scopes; see README "Atlassian access".
# Not used in oauth mode.
ATLASSIAN_API_TOKEN=replace-with-your-atlassian-api-token

# Optional, oauth mode only: the folder the sign-in is kept in. It must be an absolute path outside
# this project (default: .role-aware-assistant in your home folder).
# ATLASSIAN_OAUTH_DIR=/home/you/.role-aware-assistant

# Confluence spaces the assistant may read, comma-separated space keys
CONFLUENCE_SPACE_KEYS=ENG,PROD

# Optional: Copilot model name. Leave commented out to use your account's default model
# (run `npm run models` to list the ids). An empty value is rejected.
# COPILOT_MODEL=

# Optional: credential for Copilot itself. Leave commented out to use your logged-in user
# (`gh auth login` or `copilot login`). Never reuse GITHUB_TOKEN here: that one is the read-only
# token for the MCP servers. Create a fine-grained PAT at
# https://github.com/settings/personal-access-tokens/new owned by your personal account, with the
# "Copilot Requests" account permission. Classic tokens (ghp_...) are not supported by Copilot.
# An empty value is rejected.
# COPILOT_GITHUB_TOKEN=

# How long one question may take before it is abandoned, in milliseconds, 5000-600000
# (default: 120000)
ASK_TIMEOUT_MS=120000

# Most MCP tool calls one question may make, 1-50 (default: 12)
MAX_TOOL_CALLS=12

# Time limit for one call to an MCP server, in milliseconds, 1000-120000 (default: 30000)
MCP_TIMEOUT_MS=30000

# Most questions one conversation may hold, 1-10 (default: 5)
CONVERSATION_MAX_TURNS=5

# Most characters of source text one conversation may give the model, 10000-5000000
# (default: 250000). Past this the conversation is full and a new one is needed.
CONVERSATION_MAX_SOURCE_CHARS=250000

# Minutes without activity before a conversation is closed, 1-1440 (default: 30)
CONVERSATION_IDLE_MINUTES=30

# Minutes after which a cited source is checked again for changes, 1-1440 (default: 15)
RECHECK_AFTER_MINUTES=15

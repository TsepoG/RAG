{
  "name": "role-aware-knowledge-assistant",
  "version": "0.1.0",
  "description": "Local, role-aware RAG assistant answering from Confluence and GitHub via MCP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.js",
    "test:coverage": "vitest run --coverage",
    "ask": "node src/cli/ask.js",
    "models": "node src/cli/models.js",
    "roles": "node src/cli/roles.js",
    "eval": "node src/cli/eval.js",
    "eval:review": "node src/cli/evalReview.js",
    "eval:report": "node src/cli/evalReport.js",
    "eval:from-feedback": "node src/cli/evalFromFeedback.js",
    "screenshots": "node scripts/screenshots.js",
    "mcp:tools": "node src/cli/mcpTools.js",
    "mcp:sample": "node src/cli/mcpSample.js",
    "github:check": "node src/cli/githubCheck.js",
    "fixtures:sanitise": "node src/cli/sanitiseFixtures.js",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.19",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "5.12.7",
    "marked": "18.1.0",
    "pino": "^10.4.0",
    "sanitize-html": "2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.4",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.js": [
      "node node_modules/eslint/bin/eslint.js --fix --max-warnings=0",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "node node_modules/prettier/bin/prettier.cjs --write"
  },
  "overrides": {
    "@github/copilot-sdk": {
      "zod": "$zod"
    }
  }
}

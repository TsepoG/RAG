{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "public", "test", "*.js"],
  "exclude": ["node_modules", "coverage"]
}
